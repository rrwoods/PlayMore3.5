###############################################################################
# Set default behavior to automatically normalize line endings to LF.
###############################################################################
* text=auto eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
